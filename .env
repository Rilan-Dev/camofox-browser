# Camofox Browser Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
CAMOFOX_PORT=9377
NOVNC_PORT=6080

# Enable VNC for visual browser access
ENABLE_VNC=1

# VNC password (RFB-layer auth for both the global watcher and per-session
# bridges — see plugins/vnc/session-vnc-bridge.js). Must match
# CAMOFOX_VNC_PASSWORD in camofox-manager's .env.
VNC_PASSWORD=camofox123

# Per-session VNC grid: how many sessions can have an independent live view
# attached AT ONCE (attach/detach, not total sessions — see MAX_SESSIONS
# below for that). Each session's browser window is moved (never resized)
# into its own COLS*ROWS grid cell on the virtual display, sized
# CELL_WIDTH x CELL_HEIGHT, so concurrent sessions' feeds never show each
# other's window. The Xvfb display itself is sized to
# (COLS*CELL_WIDTH) x (ROWS*CELL_HEIGHT) automatically — no separate
# resolution setting to keep in sync. Raise COLS/ROWS if you need more than
# 16 sessions interactively viewable at the same time; each additional slot
# costs COLS*CELL_WIDTH*CELL_HEIGHT*4 bytes of Xvfb framebuffer memory.
VNC_GRID_COLS=4
VNC_GRID_ROWS=4
VNC_GRID_CELL_WIDTH=1920
VNC_GRID_CELL_HEIGHT=1080

# Optional: API key for cookie import (generate with: openssl rand -hex 32)
CAMOFOX_API_KEY=e846315c821c74bd14c262db7847d2fca6adc01830ff597a3e26e76b6bcd39ea

# Optional: Bearer token for all API routes (recommended for production)
CAMOFOX_ACCESS_KEY=

# Optional: Crash report settings
CAMOFOX_CRASH_REPORT_ENABLED=true
CAMOFOX_CRASH_REPORT_URL=https://camofox-telemetry.askjo.workers.dev/report

# Optional: Proxy configuration
# PROXY_STRATEGY=backconnect
# PROXY_BACKCONNECT_HOST=gate.provider.com
# PROXY_BACKCONNECT_PORT=7000
# PROXY_USERNAME=your-username
# PROXY_PASSWORD=your-password
# PROXY_COUNTRY=US⏎    